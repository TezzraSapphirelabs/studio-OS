rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/events/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /platformAccessKeys/{keyId} {
      allow read, write: if false;
    }

    match /platformOwners/{ownerId} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow write: if false;
    }

    match /platformAuditLogs/{logId} {
      allow read, write: if false;
    }

    // Returns the exact role for write operations (bypasses query planner limitations)
    function getProjectRole(projectId) {
      return (exists(/databases/$(database)/documents/projects/$(projectId)) && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid)
        ? 'owner'
        : (exists(/databases/$(database)/documents/members/$(projectId + "_" + request.auth.uid))
           ? get(/databases/$(database)/documents/members/$(projectId + "_" + request.auth.uid)).data.role
           : 'none');
    }

    function isRole(projectId, allowedRoles) {
      return getProjectRole(projectId) in allowedRoles;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformOwner() {
      return isAuthenticated() && exists(/databases/$(database)/documents/platformOwners/$(request.auth.uid));
    }

    // ── Helper: Check if user is a member of a project ──
    function isProjectMember(projectId) {
      let isOwner = get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid;
      let isMember = request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
      return isOwner || isMember;
    }

    // ── Helper: Check if user is a member of a workspace ──
    function isWorkspaceMember(workspaceId) {
      return exists(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid));
    }

    match /projects/{projectId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids) ||
        isPlatformOwner()
      );
      allow create: if request.auth != null && (isPlatformOwner() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null && (
        isRole(projectId, ['owner'])
        || (isRole(projectId, ['admin']) && request.resource.data.ownerUid == resource.data.ownerUid)
        // Allow a new member to add themselves to memberUids after accepting an invite
        || (exists(/databases/$(database)/documents/members/$(projectId + "_" + request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']))
      );
      allow delete: if request.auth != null && (isPlatformOwner() || isRole(projectId, ['owner']));
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isProjectMember(resource.data.projectId) || isPlatformOwner());
      allow create: if request.auth != null && (isRole(request.resource.data.projectId, ['owner', 'admin', 'member']) || isPlatformOwner());
      allow update: if request.auth != null && (
        isRole(resource.data.projectId, ['owner', 'admin'])
        // Member can update if they are the current assignee, OR if they are assigning it to themselves
        || (isRole(resource.data.projectId, ['member']) && (
             (resource.data.assigneeId == request.auth.uid) || 
             (request.resource.data.assigneeId == request.auth.uid)
           ))
      );
      allow delete: if request.auth != null && isRole(resource.data.projectId, ['owner', 'admin']);
    }

    match /activities/{activityId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        isProjectMember(resource.data.projectId) || 
        isWorkspaceMember(resource.data.projectId) ||
        ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)) ||
        isPlatformOwner()
      );
      allow create: if request.auth != null && (
        request.resource.data.ownerUid == request.auth.uid ||
        isRole(request.resource.data.projectId, ['owner', 'admin', 'member']) ||
        isWorkspaceMember(request.resource.data.projectId) ||
        isPlatformOwner()
      );
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        isRole(resource.data.projectId, ['owner', 'admin']) || 
        isPlatformOwner()
      );
    }

    match /members/{memberDocId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isProjectMember(resource.data.projectId) || isPlatformOwner());
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || isRole(request.resource.data.projectId, ['owner', 'admin']) || isPlatformOwner()
      );
      allow update: if request.auth != null && (
        isRole(resource.data.projectId, ['owner']) || 
        (isRole(resource.data.projectId, ['admin']) && request.resource.data.role != 'owner' && resource.data.role != 'owner')
      );
      allow delete: if request.auth != null && (
        isRole(resource.data.projectId, ['owner']) || 
        (isRole(resource.data.projectId, ['admin']) && resource.data.role != 'owner') ||
        resource.data.userId == request.auth.uid 
      );
    }

    match /files/{fileId} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isProjectMember(resource.data.projectId) || isPlatformOwner());
      allow create: if request.auth != null && (isProjectMember(request.resource.data.projectId) || isPlatformOwner());
      allow update: if request.auth != null && (
        isPlatformOwner() || isRole(resource.data.projectId, ['owner', 'admin']) || resource.data.ownerUid == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isRole(resource.data.projectId, ['owner', 'admin']) || resource.data.ownerUid == request.auth.uid
      );
    }

    match /folders/{folderId} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isProjectMember(resource.data.projectId) || isPlatformOwner());
      allow create: if request.auth != null && (isProjectMember(request.resource.data.projectId) || isPlatformOwner());
      allow update: if request.auth != null && (
        isPlatformOwner() || isRole(resource.data.projectId, ['owner', 'admin']) || resource.data.ownerUid == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isRole(resource.data.projectId, ['owner', 'admin']) || resource.data.ownerUid == request.auth.uid
      );
    }



    // ── Phase 6 Extensions ─────────────────────────────────────
    
    function getWorkspaceRole(workspaceId) {
      return exists(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid))
           ? get(/databases/$(database)/documents/workspaceMembers/$(workspaceId + '_' + request.auth.uid)).data.role
           : 'none';
    }

    function isWorkspaceRole(workspaceId, allowedRoles) {
      return getWorkspaceRole(workspaceId) in allowedRoles;
    }

    match /workspaceMembers/{memberId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isWorkspaceMember(resource.data.workspaceId) || isPlatformOwner());
      allow create: if request.auth != null && request.resource.data.role != 'owner' && (
        isPlatformOwner() ||
        isWorkspaceRole(request.resource.data.workspaceId, ['owner', 'admin']) ||
        request.resource.data.userId == request.auth.uid // Allow users to join via backend validation
      );
      allow update: if request.auth != null && request.resource.data.role != 'owner' && (
        isPlatformOwner() ||
        isWorkspaceRole(resource.data.workspaceId, ['owner']) ||
        (isWorkspaceRole(resource.data.workspaceId, ['admin']) && resource.data.role != 'owner')
      );
      allow delete: if request.auth != null && (
        isWorkspaceRole(resource.data.workspaceId, ['owner']) ||
        (isWorkspaceRole(resource.data.workspaceId, ['admin']) && resource.data.role != 'owner') ||
        resource.data.userId == request.auth.uid // Allow users to leave workspace
      );
    }



    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /comments/{commentId} {
      allow read: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isProjectMember(resource.data.projectId) || 
        isWorkspaceMember(resource.data.projectId) ||
        isPlatformOwner()
      );
      allow create: if request.auth != null && (
        isPlatformOwner() ||
        isProjectMember(request.resource.data.projectId) || 
        isWorkspaceMember(request.resource.data.projectId) ||
        request.resource.data.authorId == request.auth.uid
      );
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
    // ── Workspaces ─────────────────────────────────────────────
    // Note: workspaceId is currently the ownerUid
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && (isWorkspaceMember(workspaceId) || isPlatformOwner());
      allow write: if isAuthenticated() && (workspaceId == request.auth.uid || isPlatformOwner());
    }

    match /tags/{tagId} {
      allow read: if request.auth != null && (isWorkspaceMember(resource.data.workspaceId) || isPlatformOwner());
      allow create: if request.auth != null && (isWorkspaceMember(request.resource.data.workspaceId) || isPlatformOwner());
      allow update, delete: if request.auth != null && (isWorkspaceMember(resource.data.workspaceId) || isPlatformOwner());
    }
  }
}
